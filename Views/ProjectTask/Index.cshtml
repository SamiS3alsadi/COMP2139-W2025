@model IEnumerable<Lap_1.Models.ProjectTask>

@{
    ViewData["Title"] = "Tasks";
    var project = ViewBag.Project as Project;
}

<h2>Tasks for: @project?Name (@project?.Id)</h2>
<p>
    <a class="btn btn-primary" asp-action="Create" asp-route-projectId="@project?.Id"> Create New Task</a>
    <a class="btn btn-primary" asp-controller="Projects" asp-action="Index">Back to Projects</a>
</p>
@if (!Model.Any())
{
    <p class="test-muted">No tasks yet for this project.</p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Task Id</th>
            <th>Title</th>
            <th>Description</th>
            <th>Project ID</th>
            <th>Actions</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td>@t.ProjectTaskId</td>
                <td>@t.Title</td>
                <td>@t.Description</td>
                <td>@t.ProjectId</td>
                <td>
                    <a class="btn btn-info btn-sm" asp-action="Details" asp-route-id="@t.ProjectTaskId">Details</a>
                    <a class="btn btn-warning btn-sm" asp-action="Edit" asp-route-id="@t.ProjectTaskId">Edit</a>
                    <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@t.ProjectTaskId">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}