@model IEnumerable<Lap_1.Models.Project>

@{
    ViewData["Title"] = "Projects";
}

<h2>Projects</h2>

<p>
    <a class="btn btn-primary" asp-action="Create">Create New Project</a>
</p>

@if (!Model.Any())
{
    <p>No projects yet. Click “Create New Project”.</p>
}else {
    <form asp-action="Search" method="get" class="mb-3">
        <div class="input-group">
            <input name="query" value="@ViewBag.Query" class="form-control" placeholder="Search..." />
            <button class="btn btn-outline-success" type="submit">
                <i class="bi-search"></i> Search
            </button>
        </div>
    </form>
    @if (ViewBag.Searched == true && !Model.Any())
    {
        <div class="alert alert-warning mb-3">
            No projects found for "<strong>@(ViewBag.Query ?? "")</strong>".
        </div>
    }
    <table class="table">
        <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Start</th>
            <th>End</th>
            <th>Status</th>
            <th>Created</th>
            <th class="text-end">Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Name</td>
                <td>@p.Description</td>
                <td>@p.StartDate?.ToLocalTime().ToString("yy-MM-dd")</td>
                <td>@p.EndDate?.ToLocalTime().ToString("yy-MM-dd")</td>
                <td>@p.Status</td>
                <td>@p.CreatedAt.ToLocalTime().ToString("yy-MM-dd")</td>
                <td class="text-end">
                
                    <a class="btn btn-info btn-sm" asp-action="Details" asp-route-id="@p.Id">Details</a>
                    <a class="btn btn-warning btn-sm" asp-action="Edit" asp-route-id="@p.Id">Edit</a>
                    <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@p.Id">Delete</a>
                    <a class="btn btn-secondary btn-sm" asp-controller="ProjectTask" asp-action="Index" asp-route-projectId="@p.Id">View Tasks</a>
            </tr>
        }
        </tbody>
    </table> 
}