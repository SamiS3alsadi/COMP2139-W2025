@model IEnumerable<Lap_1.Models.Project>
@{
    ViewData["Title"] = "Projects";
}
<h2>Projects</h2>
<p><a class="btn btn-primary" asp-action="Create">Create New Project</a></p>
@if (!Model.Any())
{
    <p>No projects yet. Click “Create New Project”.</p>
}
else
{
    <table class="table">
        <thead><tr><th>Name</th><th>Description</th><th>Created</th><th></th></tr></thead>
        <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Name</td>
                <td>@p.Description</td>
                <td>@p.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td><a asp-action="Details" asp-route-id="@p.Id">Details</a></td>
            </tr>
        }
        </tbody>
    </table>
}