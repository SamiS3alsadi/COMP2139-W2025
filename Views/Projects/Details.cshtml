@model Lap_1.Models.Project
@{
    ViewData["Title"] = "Project Details";
}
<h2>@Model.Name</h2>
<p>@Model.Description</p>
<p><b>Created:</b> @Model.CreatedAt</p>
<p><b>Start Date:</b> @Model.StartDate?.ToString("yyyy-MM-dd")</p>
<p><b>End Date:</b> @Model.EndDate?.ToString("yyyy-MM-dd"))</p>
<p>
    <b>Status:</b>
    <span class="badge bg-info">@Model.Status</span>
</p>

<p>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to list</a>
</p>