@{
    ViewData["Title"] = "Project Management Home";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-body text-center">
            <h2 class="text-primary">Welcome to Project Management</h2>
            <p class="lead">Manage your projects, tasks, and comments easily.</p>

            <a asp-area="ProjectManagement"
               asp-controller="Projects"
               asp-action="Index"
               class="btn btn-primary btn-lg">
                View Projects
            </a>
        </div>
    </div>
</div>