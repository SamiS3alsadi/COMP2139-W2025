      <_ContentIncludedByDefault Remove="Views\DisplayTemplates\ProjectName.cshtml" />
      <_ContentIncludedByDefault Remove="Views\DisplayTemplates\ProjectTaskTitle.cshtml" />
    </ItemGroup>

</Project>