@model IEnumerable<Lap_1.Areas.ProjectManagement.Models.Project>
@{
    ViewData["Title"] = "Projects";
}

<h2>Projects List</h2>

<p>
    <a asp-area="ProjectManagement" asp-action="Create" class="btn btn-primary">Create New Project</a>
</p>

<table class="table table-striped">
    <thead>
    <tr>
        <th>Project Name</th>
        <th>Description</th>
        <th>Start Date</th>
        <th>End Date</th>
        <th>Status</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Description</td>
            <td>@item.StartDate?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)</td>
            <td>@item.EndDate?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)</td>
            <td>@item.Status</td>
            <td>
                <a asp-area="ProjectManagement" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm">Details</a>
                <a asp-area="ProjectManagement" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm">Edit</a>
                <a asp-area="ProjectManagement" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">Delete</a>

                <a asp-area="ProjectManagement"
                   asp-controller="ProjectTask"
                   asp-action="Index"
                   asp-route-projectId="@item.Id"
                   class="btn btn-outline-primary btn-sm">View Tasks</a>

                <a asp-area="ProjectManagement"
                   asp-controller="ProjectTask"
                   asp-action="Create"
                   asp-route-projectId="@item.Id"
                   class="btn btn-primary btn-sm">New Task</a>
            </td>
        </tr>
    }
    </tbody>
</table>