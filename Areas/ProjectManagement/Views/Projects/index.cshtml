<table class="table table-striped table-bordered text-center align-middle shadow-sm" style="border-color: #000; border-width: 1.5px;">
    <thead style="background-color: black; color: white; font-weight: bold;">
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Description</th>
            <th>Summary</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var project in Model)
        {
            <tr>
                <td><b>@project.ProjectId</b></td>

                <td>
                    <a asp-area="ProjectManagement"
                       asp-controller="Projects"
                       asp-action="Details"
                       asp-route-id="@project.ProjectId"
                       style="font-weight: bold; color: blue; text-decoration: underline;">
                        @project.Name
                    </a>
                </td>

                <td style="color: red;">@project.Description</td>

                <td class="text-start">
                    <a asp-area="ProjectManagement"
                       asp-controller="Projects"
                       asp-action="Details"
                       asp-route-id="@project.ProjectId"
                       style="font-weight: bold; color: blue; text-decoration: underline;">
                        @project.Name
                    </a>
                    <p style="color: red;">@project.Description</p>
                    <p><b>Start Date:</b> @project.StartDate.ToString("MMMM dd, yyyy")</p> // readable month names
                    <p><b>End Date:</b> @project.EndDate.ToString("MMMM dd, yyyy")</p>
                    <p><b>Status:</b> @project.Status</p>
                    <p><b>Tasks:</b></p>
                    <ul>
                        @if (project.Tasks != null && project.Tasks.Count > 0)
                        {
                            foreach (var task in project.Tasks)
                            {
                                <li>
                                    <span style="font-weight: bold; color: green;">@task.Title</span>
                                    -
                                    <span style="color: red;">@task.Description</span>
                                </li>
                            }
                        }
                        else
                        {
                            <li style="color: gray;">No tasks available.</li>
                        }
                    </ul>
                </td>

                <td class="text-center">
                    <a asp-area="ProjectManagement"
                       asp-controller="Projects"
                       asp-action="Details"
                       asp-route-id="@project.ProjectId"
                       class="btn btn-info btn-sm fw-semibold me-1">
                        Details
                    </a>
                    <a asp-area="ProjectManagement"
                       asp-controller="Projects"
                       asp-action="Edit"
                       asp-route-id="@project.ProjectId"
                       class="btn btn-secondary btn-sm fw-semibold me-1">
                        Edit
                    </a>
                    <a asp-area="ProjectManagement"
                       asp-controller="Projects"
                       asp-action="Delete"
                       asp-route-id="@project.ProjectId"
                       class="btn btn-danger btn-sm fw-semibold me-1">
                        Delete
                    </a>
                    <a asp-area="ProjectManagement"
                       asp-controller="ProjectTask"
                       asp-action="Index"
                       asp-route-projectId="@project.ProjectId"
                       class="btn btn-warning btn-sm fw-semibold">
                        View Tasks
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>