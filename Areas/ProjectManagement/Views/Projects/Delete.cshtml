@model Lap_1.Areas.ProjectManagement.Models.Project
@{
    ViewData["Title"] = "Delete Project";
}

<h2 class="mb-3 text-danger">Delete Project</h2>

<h4>Are you sure you want to delete this project?</h4>
<hr />

<div class="mb-4">
    <dl class="row">
        <dt class="col-sm-3 fw-bold">Project Name</dt>
        <dd class="col-sm-9" style="color: blue">@Model.Name</dd>

        <dt class="col-sm-3 fw-bold">Description</dt>
        <dd class="col-sm-9" style="color: red">@Model.Description</dd>

        <dt class="col-sm-3 fw-bold">Start Date</dt>
        <dd class="col-sm-9">@Model.StartDate?.ToShortDateString()</dd>

        <dt class="col-sm-3 fw-bold">End Date</dt>
        <dd class="col-sm-9">@Model.EndDate?.ToShortDateString()</dd>

        <dt class="col-sm-3 fw-bold">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>
    </dl>
</div>

<form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
    @Html.HiddenFor(m => m.Id)
    <button type="submit" class="btn btn-danger">
        <i class="fa-solid fa-trash"></i> Delete
    </button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}