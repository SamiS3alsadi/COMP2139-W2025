@model Lap_1.Areas.ProjectManagement.Models.Project

@{
    ViewData["Title"] = "Project Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>@ViewData["Title"]</h2>

<div class="card shadow-sm" style="border: 1px solid #ddd;">
    <div class="card-body">

        <h3>
            <a style="color: #0d6efd; text-decoration: underline; font-weight: bold;">
                @Model.Name
            </a>
        </h3>

        <p style="color: red; font-size: 1.1rem; margin-bottom: 20px;">
            @Model.Description
        </p>

        <p><strong>Project ID:</strong> @Model.ProjectId</p>

        <p><strong>Start Date:</strong>
            @Model.StartDate.ToString("MMMM dd, yyyy")
        </p>

        <p><strong>End Date:</strong>
            @Model.EndDate.ToString("MMMM dd, yyyy")
        </p>

        <p><strong>Status:</strong>
            <a style="color: #0d6efd; font-weight: bold;">@Model.Status</a>
        </p>

        <a asp-area="ProjectManagement"
           asp-controller="Projects"
           asp-action="Edit"
           asp-route-id="@Model.ProjectId"
           class="btn btn-primary me-2">
            Edit
        </a>

        <a asp-area="ProjectManagement"
           asp-controller="Projects"
           asp-action="Index"
           class="btn btn-secondary">
            Back to Projects
        </a>

    </div>
</div>

<br />

<h3>Comments</h3>

<div id="comments-section" class="mt-3">
</div>

<hr />

<h5 style="font-weight: 600;">Add a comment…</h5>

<textarea id="commentContent"
          class="form-control mb-2"
          placeholder="Add a comment…"
          style="border: 1px solid #ccc; padding: 10px; border-radius: 6px;">
</textarea>

<button id="addCommentBtn"
        class="btn btn-success"
        style="font-weight: 600; padding: 6px 16px;">
    Post Comment
</button>

<input type="hidden" id="projectId" value="@Model.ProjectId" />


@section Scripts {
    <script src="~/js/projectComments.js"></script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}