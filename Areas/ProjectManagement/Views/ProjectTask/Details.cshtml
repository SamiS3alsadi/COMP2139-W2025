@model Lap_1.Areas.ProjectManagement.Models.ProjectTask

@{
    ViewData["Title"] = "Task Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>@ViewData["Title"]</h2>

<div>
    <h4>Task Details</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Title)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Title)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>

        <!-- Display associated project name -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Project.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Project.Name)
        </dd>
    </dl>
</div>

<div>
    <a asp-area="ProjectManagement"
       asp-controller="ProjectTask"
       asp-action="Edit"
       asp-route-id="@Model.ProjectTaskId"
       class="btn btn-primary">
        Edit
    </a>

    <a asp-area="ProjectManagement"
       asp-controller="ProjectTask"
       asp-action="Index"
       asp-route-projectId="@Model.ProjectId"
       class="btn btn-secondary">
        Back to List
    </a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}