@model IEnumerable<Lap_1.Areas.ProjectManagement.Models.ProjectTask>

@{
    ViewData["Title"] = "Tasks List";
    bool searchPerformed = ViewData["SearchPerformed"] as bool? ?? false;
    string searchString = ViewData["SearchString"] as string;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>@ViewData["Title"]</h2>

@if (Model.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Task ID</th>
                <th>Title</th>
                <th>Description</th>
                <th>Project ID</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var task in Model)
            {
                <tr>
                    <td>@task.ProjectTaskId</td>
                    <td>@task.Title</td>
                    <td>@task.Description</td>
                    <td>@task.ProjectId</td>
                    <td>
                        <a asp-area="ProjectManagement"
                           asp-controller="ProjectTask"
                           asp-action="Details"
                           asp-route-id="@task.ProjectTaskId"
                           class="btn btn-info btn-sm">
                            Details
                        </a>
                        <a asp-area="ProjectManagement"
                           asp-controller="ProjectTask"
                           asp-action="Edit"
                           asp-route-id="@task.ProjectTaskId"
                           class="btn btn-warning btn-sm">
                            Edit
                        </a>
                        <a asp-area="ProjectManagement"
                           asp-controller="ProjectTask"
                           asp-action="Delete"
                           asp-route-id="@task.ProjectTaskId"
                           class="btn btn-danger btn-sm">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    @if (searchPerformed)
    {
        <p>No tasks found with the name "@searchString".</p>
    }
    else
    {
        <p>No tasks available.</p>
    }
}

<!-- Button to create a new task -->
<a asp-area="ProjectManagement"
   asp-controller="ProjectTask"
   asp-action="Create"
   asp-route-projectId="@ViewBag.ProjectId"
   class="btn btn-primary">
    Create New Task
</a>

<!-- Button to go back to the list of projects -->
<a asp-area="ProjectManagement"
   asp-controller="Projects"
   asp-action="Index"
   class="btn btn-secondary">
    Back to Projects
</a>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}