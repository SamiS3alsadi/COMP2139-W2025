@model Lap_1.Areas.ProjectManagement.Models.ProjectTask
@{
    ViewData["Title"] = "Delete Task";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card p-4 shadow-sm mt-4">
    <h2 class="text-danger mb-3">
        <i class="fa-solid fa-trash-can me-2"></i> Delete Task
    </h2>
    <h5>Are you sure you want to delete this task?</h5>

    @if (Model != null)
    {
        <dl class="row mt-3">
            <dt class="col-sm-3 fw-bold">Title</dt>
            <dd class="col-sm-9">@Model.Title</dd>
            <dt class="col-sm-3 fw-bold">Description</dt>
            <dd class="col-sm-9">@Model.Description</dd>
        </dl>
    }
    else
    {
        <div class="alert alert-warning">Task not found.</div>
    }

    <form asp-area="ProjectManagement"
          asp-controller="ProjectTask"
          asp-action="Delete"
          asp-route-id="@Model.TaskId"
          method="post"
          class="mt-3">
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.TaskId)

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">
                <i class="fa-solid fa-trash"></i> Delete
            </button>
            <a class="btn btn-secondary"
               asp-area="ProjectManagement"
               asp-controller="ProjectTask"
               asp-action="Index"
               asp-route-projectId="@Model.ProjectId">
                <i class="fa-solid fa-arrow-left"></i> Back to Tasks
            </a>
        </div>
    </form>
</div>