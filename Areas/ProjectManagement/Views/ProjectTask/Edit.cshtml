@model Lap_1.Areas.ProjectManagement.Models.ProjectTask

@{
    ViewData["Title"] = "Edit Task";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Edit Task</h2>

<form asp-area="ProjectManagement"
      asp-controller="ProjectTask"
      asp-action="Edit"
      method="post">
    @Html.AntiForgeryToken()

    <!-- Keys -->
    <input asp-for="TaskId" type="hidden" />
    <input asp-for="ProjectId" type="hidden" />

    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <input asp-for="Description" class="form-control" />
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a class="btn btn-secondary"
       asp-area="ProjectManagement"
       asp-controller="ProjectTask"
       asp-action="Index"
       asp-route-projectId="@Model.ProjectId">Cancel</a>
</form>